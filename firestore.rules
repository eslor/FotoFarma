rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().size() >= 2 && data.keys().size() <= 8 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidReminder(data) {
      return data.keys().hasAll(['uid', 'name', 'time', 'date']) &&
             data.keys().size() >= 4 && data.keys().size() <= 15 &&
             data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.time is string && (data.time == 'AHORA' || data.time.matches('^\\d{2}:\\d{2}$')) &&
             data.date is string && (data.date == '' || data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')) &&
             (!('dosage' in data) || (data.dosage is string && data.dosage.size() <= 200)) &&
             (!('frequency' in data) || (data.frequency is string && data.frequency.size() <= 200)) &&
             (!('duration' in data) || (data.duration is string && data.duration.size() <= 200)) &&
             (!('comments' in data) || (data.comments is string && data.comments.size() <= 1000)) &&
             (!('endDate' in data) || (data.endDate is string && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))) &&
             (!('prescriptionId' in data) || (data.prescriptionId is string && data.prescriptionId.size() <= 128)) &&
             (!('completed' in data) || data.completed is bool);
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['uid', 'dayStartTime', 'acceptedTerms']) &&
             data.uid == request.auth.uid &&
             data.dayStartTime is string && data.dayStartTime.matches('^\\d{2}:\\d{2}$') &&
             data.acceptedTerms is bool;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) &&
                    incoming().uid == existing().uid;
    }

    match /reminders/{reminderId} {
      allow list: if true; // Emergency fix for worker
      allow get: if isOwner(existing().uid);
      allow create: if isOwner(incoming().uid) && isValidReminder(incoming());
      allow update: if isOwner(existing().uid) && isValidReminder(incoming()) &&
                    incoming().uid == existing().uid;
      allow delete: if isOwner(existing().uid);
    }

    match /prescriptions/{prescriptionId} {
      allow read: if isOwner(existing().uid);
      allow create: if isOwner(incoming().uid);
      allow update: if isOwner(existing().uid) && incoming().uid == existing().uid;
      allow delete: if isOwner(existing().uid);
    }

    match /user_settings/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidSettings(incoming());
    }

    match /push_subscriptions/{subId} {
      allow read: if true; // Emergency fix for worker
      allow create: if isOwner(incoming().uid);
      allow delete: if isOwner(existing().uid);
    }
  }
}
